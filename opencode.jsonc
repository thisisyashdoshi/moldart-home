{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "share": "disabled",
  "snapshot": true,
  "default_agent": "build",
  "instructions": ["AGENTS.md"],
  "plugin": [],
  "command": {
    "goal": {
      "description": "Run the Moldart website quality goal loop locally without deployment.",
      "template": "Run the Moldart website goal loop in the active static work directory. Use `npm run goal` first. Treat failures as blockers. Do not deploy, push, change DNS, change Cloudflare, or modify secrets. Summarize the generated `.tmp/moldart-quality-monitor-report.md`, the YouTube/media coverage counts, and the next safest improvement."
    },
    "automation-status": {
      "description": "Check the self-hosted/FOSS-compatible monitoring status for the Moldart draft.",
      "template": "Run `npm run monitor:site` in the active static work directory and summarize `.tmp/moldart-quality-monitor-report.md`. If a local preview is already running, also run `node scripts/moldart-quality-monitor.mjs --base=http://127.0.0.1:4173`. Do not start persistent services, deploy, push, change DNS, or change Cloudflare."
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*secret*": "deny",
      "**/*Secret*": "deny",
      "**/*credential*": "deny",
      "**/*Credential*": "deny",
      "**/API-KEYS.txt": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.crt": "deny",
      "**/*.cer": "deny",
      "**/.opencode/plugins/secret-guard.js": "allow",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*secret*": "deny",
      "**/*Secret*": "deny",
      "**/*credential*": "deny",
      "**/*Credential*": "deny",
      "**/API-KEYS.txt": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.crt": "deny",
      "**/*.cer": "deny",
      "**/.opencode/commands/**": "deny",
      "**/.opencode/plugins/**": "deny",
      "**/.opencode/skills/**": "deny",
      "**/.opencode/tools/**": "deny",
      "**/.opencode/agents/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "opencode debug*": "allow",
      "opencode mcp list*": "allow",
      "opencode models*": "allow",
      "node --version*": "allow",
      "npm --version*": "allow",
      "npm run build*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run check*": "allow",
      "git push*": "deny",
      "git push *": "deny",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "Remove-Item * -Recurse -Force*": "deny",
      "npm install*": "deny",
      "npm update*": "deny",
      "npm upgrade*": "deny",
      "pnpm install*": "deny",
      "pnpm update*": "deny",
      "pnpm upgrade*": "deny",
      "yarn install*": "deny",
      "yarn upgrade*": "deny",
      "bun install*": "deny",
      "bun update*": "deny",
      "mise upgrade*": "deny",
      "mise self-update*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "yarn publish*": "deny",
      "npm run deploy*": "deny",
      "npm run publish*": "deny",
      "npm run release": "deny",
      "netlify deploy*": "deny",
      "vercel*": "deny",
      "wrangler deploy*": "deny",
      "firebase deploy*": "deny",
      "gh release*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask",
    "task": "ask",
    "skill": {
      "*": "ask",
      "website-quality-loop": "allow",
      "trade-portal-release-gate": "allow",
      "secret-hygiene": "allow",
      "system-guardrails": "allow",
      "website-release-manager": "allow",
      "performance-a11y-auditor": "allow",
      "lead-ops-integrator": "allow",
      "evidence-claim-editor": "allow",
      "seo-content-auditor": "allow",
      "product-content-modeler": "allow",
      "frontend-conversion-designer": "allow",
      "portal-security-reviewer": "allow"
    }
  }
}
