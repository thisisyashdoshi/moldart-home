  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/thisisyashdoshi/moldart-home/issues"
  },
  "homepage": "https://github.com/thisisyashdoshi/moldart-home#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "clean-css-cli": "^5.6.3",
    "lighthouse": "^13.3.0",
    "purgecss": "^8.0.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "ws": "8.21.0"
  }
