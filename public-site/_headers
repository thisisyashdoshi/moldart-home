/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), fullscreen=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://static.cloudflareinsights.com https://cloudflareinsights.com https://*.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/portal/
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/portal/index.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/portal/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/open-wood-science/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/open-wood-science/internal-control/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/open-wood-science/reviewer-intake/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/main.js
  Cache-Control: public, max-age=31536000, immutable

/lead-forms.js
  Cache-Control: public, max-age=31536000, immutable

/pages.css
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=86400

/sitemap-images.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/.well-known/security.txt
  Cache-Control: public, max-age=86400

/security.txt
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/downloads/*
  Cache-Control: public, max-age=2592000
